<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detailNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Nome" />

        <TextView
            android:id="@+id/detailPortata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Portata" />

        <TextView
            android:id="@+id/detailNutrienti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nutrienti" />

        <!-- nuovo pulsante preferito sotto detailNutrienti -->
        <Button
            android:id="@+id/btn_toggle_preferito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_green_button"
            android:drawablePadding="8dp"
            android:drawableLeft="@drawable/ic_star_outline"
            android:text="AGGIUNGI AI PREFERITI"
            android:textAllCaps="true"
            android:textColor="@android:color/white" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnModifica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Modifica" />

            <Button
                android:id="@+id/btnElimina"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Elimina" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
